#   shared/anonymous ACL list
topic   read       $SYS/#
pattern write      $SYS/broker/connection/%c/state

#   user ACL list (bridge connection)
user    {{ broker[instance.name].bridge.user }}
topic   readwrite  $SYS/#
topic   readwrite  #
topic   readwrite  $share/#

#   user ACL list (backend connection)
user    {{ broker[instance.name].backend.user }}

#   ---- event emission ----

topic   write     frontend/+/event-emission/+

topic   read      backend/+/event-emission/any
