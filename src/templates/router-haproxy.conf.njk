##
##  router-haproxy.conf -- Router HAProxy Configuration
##  ATTENTION: THIS FILE IS GENERATED -- DO NOT EDIT!
##

global
    log             stderr daemon debug emerg
    pidfile         ./router.pid
    stats socket    unix@./router.sock mode 600 level admin
    stats timeout   2m
    user            app
    group           app
    maxconn         4096
    nbthread        16

defaults
    log             global
    option          dontlognull
    option          contstats
{%- if logLevel == "debug" %}
    option          tcplog
{%- endif %}
    retries         3
    option          redispatch
    maxconn         2000
    timeout connect 5s
    timeout client  60s
    timeout server  60s
    timeout tunnel  120s


listen stats
    bind            127.0.0.1:6644
    mode            http
    maxconn         10
    no log
    acl             network_allowed src 127.0.0.0/8
    tcp-request     connection reject if !network_allowed
    http-request    use-service prometheus-exporter if { path /metrics }
    stats enable
    stats uri       /

frontend fe
    bind            {{ router.service.addr }}:{{ router.service.port }} name tcp
    mode            tcp

    maxconn         10000
    backlog         10000

    default_backend be_proxy

backend be_proxy
    mode            tcp
    balance         roundrobin
    {%- for i in range(0, proxy.instances) %}
    server          proxy-{{ ((i | int) + 1) | pad(2, '0') }} {{ proxy.frontend.addr }}:{{ (proxy.frontend.port | int) + (i | int) }} maxconn 10000 check inter 2000 rise 2 fall 5
    {%- endfor %}

{%- if router.acme %}

frontend fe_acme
    bind            {{ router.acme.addr }}:{{ router.acme.port }} name acme
    mode            tcp

    maxconn         10000
    backlog         10000

    default_backend be_acme

backend be_acme
    mode            tcp
    server          acme {{ proxy.tls.addr }}:{{ proxy.tls.port }} maxconn 10000 check inter 2000 rise 2 fall 5

{%- endif %}

